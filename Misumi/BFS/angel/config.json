      },
      "output_file":"nsk_output_roller_bearings_results_with_html.jsonl",
      "checkpoint_interval":5000,
      "checkpoint_path":"nsk_crawl.checkpoint"
    },
    "takigen":{
      "start_url": "https://www.takigen.com/",
      "max_depth":2,
      "allowed_domains":["takigen.com"],
      "url_patterns": ["*products*"],
