{
  "default": {
    "include_external": false,
    "headless": false,
    "scraping_strategy": "LXMLWebScrapingStrategy",
    "verbose": true,
    "scan_full_page": true,
    "delay_before_return_html": 10.0
  },
  "websites": {
    "misumi_usa": {
        "start_url": "https://us.misumi-ec.com/vona2/mech_screw/M1808000000/",
        "allowed_domains": [
            "us.misumi-ec.com"
        ],
        "max_depth": 3,
        "url_patterns": [
            ".*vona2/mech_screw/.*",
            ".*vona2/detail/.*"
        ],
        "keywords": {
            "specifications": 1.0,
            "Part Numbers": 1.0,
            "codeList": 1.0,
            "dimensions": 0.7,
            "price": 0.5,
            "drawing": 0.5,
            "HissuCode": 1.0,
            "tab": 1.0
        },
        "output_file": "misumi_product_data.json"
      },
    "mysamick": {
      "start_url": "https://www.mysamick.com",
      "max_depth": 2,
      "allowed_domains": ["mysamick.com"],
      "url_patterns": ["*product*", "*new_product*"],
      "keywords": {
        "product": 0.7,
        "newproduct": 0.7
      },
      "output_file": "mysamick_crawled_results.jsonl",
      "checkpoint_interval": 500,
      "checkpoint_path": "mysamick_crawl.checkpoint"
    },
    "nbk":{
      "start_url":"https://www.nbk1560.com/",
      "max_depth":5,
      "allowed_domains": ["nbk1560.com"],
      "url_patterns": ["*products*"],
