        "products":0.7
      },
      "output_file": "nbk_crawled_results.jsonl",
      "checkpoint_interval":5000,
      "checkpoint_path":"nbk_crawl.checkpoint"
    },
    "nsk":{
      "start_url": "https://www.oss.nsk.com/products/bearings/roller-bearings.html",
      "max_depth":4,
      "allowed_domains": ["nsk.com"],
      "url_patterns": ["^https://www\\.oss\\.nsk\\.com/products/bearings/roller-bearings/.*" ],
      "keywords":{
        "products":0.7,
        "bearings":0.8,
